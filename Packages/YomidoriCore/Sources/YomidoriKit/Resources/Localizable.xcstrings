  "strings" : {
    "Camera access is off. Turn it on in Settings to frame a page." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフになっています。設定でオンにすると、ページを撮影できます。"
          }
        }
      }
    },
    "Choose a photo" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を選ぶ"
