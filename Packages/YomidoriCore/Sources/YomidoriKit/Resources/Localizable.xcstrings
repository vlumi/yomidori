{
  "sourceLanguage" : "en",
  "strings" : {
    "About" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリについて"
          }
        }
      }
    },
    "Again" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度"
          }
        }
      }
    },
    "Camera access is off. Turn it on in Settings to frame a page." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフになっています。設定でオンにすると、ページを撮影できます。"
          }
        }
      }
    },
    "Cards" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード"
          }
        }
      }
    },
    "Choose a photo" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を選ぶ"
          }
        }
      }
    },
    "Close-up" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡大"
          }
        }
      }
    },
    "Copy" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー"
          }
        }
      }
    },
    "Everything runs on this device: the camera, the text recognition, the dictionaries, your cards. Nothing is sent anywhere." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラも、文字の読み取りも、辞書も、カードも、すべてこの端末の中で動きます。どこにも送信しません。"
          }
        }
      }
    },
    "Flat: low, then high to the end and beyond." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平板型：低く始まり、高いまま続きます。"
          }
        }
      }
    },
    "Good" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できた"
          }
        }
      }
    },
    "Head-high: the first mora high, then low." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭高型：最初の拍だけ高く、あとは低くなります。"
          }
        }
      }
    },
    "How pitch is drawn" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセントの表し方"
          }
        }
      }
    },
    "JMdict by the Electronic Dictionary Research and Development Group; pitch accents from Kanjium by Uros O.; MeCab and IPADic; Mecab-Swift. Their terms are inside." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electronic Dictionary Research and Development GroupのJMdict、Uros O.によるKanjiumのアクセントデータ、MeCabとIPADic、Mecab-Swift。各ライセンスは中にあります。"
          }
        }
      }
    },
    "Keep" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残す"
          }
        }
      }
    },
    "Kept" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残しました"
          }
        }
      }
    },
    "Licenses and notices" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスと表示"
          }
        }
      }
    },
    "Live Text" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト認識表示"
          }
        }
      }
    },
    "Live Text is not available on this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末ではテキスト認識表示を使えません。"
          }
        }
      }
    },
    "Meaning" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味"
          }
        }
      }
    },
    "MeCab could not load its dictionary." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeCabの辞書を読み込めませんでした。"
          }
        }
      }
    },
    "Mid-high: the drop after the numbered mora." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中高型：数字の拍のあとで下がります。"
          }
        }
      }
    },
    "No camera here. Choose a photo instead." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラがありません。写真を選んでください。"
          }
        }
      }
    },
    "No cards yet. Tap a word under a page and keep it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードはまだありません。ページの下の言葉をタップして残してください。"
          }
        }
      }
    },
    "Not in the dictionary." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辞書にありません。"
          }
        }
      }
    },
    "Nothing due. Read on." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の分はありません。読書を続けてください。"
          }
        }
      }
    },
    "Nothing was recognized." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字が見つかりませんでした。"
          }
        }
      }
    },
    "Point at a word, get its reading." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉に向けると、読みがわかる。"
          }
        }
      }
    },
    "Reading the page…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取り中…"
          }
        }
