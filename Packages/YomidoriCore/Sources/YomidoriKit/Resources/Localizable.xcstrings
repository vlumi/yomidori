            "value" : "文を直す"
          }
        }
      }
    },
    "Everything runs on this device: the camera, the text recognition, the dictionaries, your cards. Nothing is sent anywhere." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラも、文字の読み取りも、辞書も、カードも、すべてこの端末の中で動きます。どこにも送信しません。"
          }
        }
      }
    },
    "Flat: low, then high to the end and beyond." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
